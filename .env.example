# ==========================================
# Bybit V5 Unified Trading Account API Keys
# ==========================================
# Generate these at: https://www.bybit.com/app/user/api-management
# Required permissions: "Contract - Orders", "Contract - Positions"
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Set to "true" to use testnet (recommended for first-time setup)
BYBIT_TESTNET=false

# ─── Optional tuning ──────────────────────────────────────────────
# Default $ risk per trade (net loss when stopped, fees included)
# DEFAULT_RISK_USD=100.0

# Your fee tier (defaults are Bybit VIP0 linear perp). Used so risk sizing,
# breakeven, and the journal are fee-aware. Maker = limit, Taker = market.
# FEE_MAKER_RATE=0.0002
# FEE_TAKER_RATE=0.00055

# Price reference that fires the Stop Loss: MarkPrice (default, matches the
# liquidation engine so the SL always fires before liquidation) or LastPrice.
# SL_TRIGGER_BY=MarkPrice

# Room between the stop and the liquidation price, % of entry. The stop always
# triggers first (both read mark); this is the room for its market order to
# fill. Costs margin only — 0.5 is reasonable on thin alts.
# LIQ_CUSHION_PCT=0.2

# ─── Risk governance (top-bar strip, confirms and blocks) ─────────
# Risk on one trade above this share of equity asks for a hard confirm.
# MAX_RISK_PCT=2.0
# Open risk (sum of $ at the stops) above this share of equity asks for a confirm.
# MAX_OPEN_RISK_PCT=6.0
# Realised loss today at which no new trades are accepted. 0 = off.
# DAILY_LOSS_LIMIT_USD=0
# Consecutive losses at which a new trade asks for a confirm. 0 = off.
# LOSS_STREAK_CONFIRM=3

# ─── Strat1 ratchet ───────────────────────────────────────────────
# "progress:lockR, …" — at ≥ progress of the entry→TP journey, move the stop
# to lock lockR in original stop distances: -0.5 = half the stop still at
# risk, 0 = fee-adjusted break-even, +0.5 = break-even plus half an R.
# STRAT1_RATCHET=0.75:-0.5,0.90:0

# Risk-ledger entries older than this are pruned; keep it above your longest hold.
# RISK_LEDGER_MAX_AGE_DAYS=365
